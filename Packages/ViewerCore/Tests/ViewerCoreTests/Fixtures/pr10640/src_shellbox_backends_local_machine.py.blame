	def _unlock_directories(descriptor: int) -> None:
cbac3420ccf77fd967760d55a006a72dbc05b8c8 172 174
	    # O_PATH opens even mode000 directories. The proc link refers to this pinned
cbac3420ccf77fd967760d55a006a72dbc05b8c8 173 175
	    # directory, so neither chmod nor traversal can follow a guest symlink out.
cbac3420ccf77fd967760d55a006a72dbc05b8c8 174 176
	    pinned = f"/proc/self/fd/{descriptor}"
cbac3420ccf77fd967760d55a006a72dbc05b8c8 175 177
	    os.chmod(pinned, 0o700)
cbac3420ccf77fd967760d55a006a72dbc05b8c8 176 178
	    with os.scandir(pinned) as entries:
cbac3420ccf77fd967760d55a006a72dbc05b8c8 177 179
	        for entry in entries:
cbac3420ccf77fd967760d55a006a72dbc05b8c8 178 180
	            if not entry.is_dir(follow_symlinks=False):
cbac3420ccf77fd967760d55a006a72dbc05b8c8 179 181
	                continue
cbac3420ccf77fd967760d55a006a72dbc05b8c8 180 182
	            child = os.open(entry.name, os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=descriptor)
cbac3420ccf77fd967760d55a006a72dbc05b8c8 181 183
	            try:
cbac3420ccf77fd967760d55a006a72dbc05b8c8 182 184
	                _unlock_directories(child)
cbac3420ccf77fd967760d55a006a72dbc05b8c8 183 185
	            finally:
cbac3420ccf77fd967760d55a006a72dbc05b8c8 184 186
	                os.close(child)
