	def _submounts(mountinfo: str, directories: Iterable[str]) -> tuple[str, ...]:
52b8b1adf4d8db34deb185bef4901e62d14550ad 170 209
	    """The mount points strictly inside ``directories``, parents first, from the text of ``/proc/self/mountinfo``."""
52b8b1adf4d8db34deb185bef4901e62d14550ad 171 210
	    points = []
52b8b1adf4d8db34deb185bef4901e62d14550ad 172 211
	    for line in mountinfo.splitlines():
52b8b1adf4d8db34deb185bef4901e62d14550ad 173 212
	        # The kernel escapes space, tab, newline and backslash in mount points as three octal digits.
52b8b1adf4d8db34deb185bef4901e62d14550ad 174 213
	        point = re.sub(r"\\([0-7]{3})", lambda match: chr(int(match[1], 8)), line.split()[4])
52b8b1adf4d8db34deb185bef4901e62d14550ad 175 214
	        if any(PurePosixPath(point).is_relative_to(directory) and point != directory for directory in directories):
52b8b1adf4d8db34deb185bef4901e62d14550ad 176 215
	            points.append(point)
52b8b1adf4d8db34deb185bef4901e62d14550ad 177 216
	    return tuple(sorted(dict.fromkeys(points), key=lambda point: (point.count("/"), point)))
52b8b1adf4d8db34deb185bef4901e62d14550ad 178 217
	
52b8b1adf4d8db34deb185bef4901e62d14550ad 179 218
	
